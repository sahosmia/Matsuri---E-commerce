{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="pull-right">
        <button type="button" id="button-export-all" data-toggle="tooltip" title="Export All to Excel" class="btn btn-success"><i class="fa fa-file-excel-o"></i> Export</button>
        <button type="button" data-toggle="tooltip" title="{{ button_filter }}" onclick="$('#filter-product').toggleClass('hidden-sm hidden-xs');" class="btn btn-default hidden-md hidden-lg"><i class="fa fa-filter"></i></button>
      </div>
      <h1>{{ heading_title }}</h1>
      <ul class="breadcrumb">
        {% for breadcrumb in breadcrumbs %}
        <li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
        {% endfor %}
      </ul>
    </div>
  </div>
  <div class="container-fluid">
    <div class="row">
      <div id="filter-product" class="col-md-3 col-md-push-9 col-sm-12 hidden-sm hidden-xs">
        <div class="panel panel-default">
          <div class="panel-heading">
            <h3 class="panel-title"><i class="fa fa-filter"></i> {{ text_filter }}</h3>
          </div>
          <div class="panel-body">
            <div class="form-group">
              <label class="control-label" for="input-name">{{ entry_name }}</label>
              <input type="text" name="filter_name" value="{{ filter_name }}" placeholder="{{ entry_name }}" id="input-name" class="form-control" autocomplete="off" />
            </div>
            <div class="form-group">
              <label class="control-label" for="input-sku">{{ entry_sku }}</label>
              <input type="text" name="filter_sku" value="{{ filter_sku }}" placeholder="{{ entry_sku }}" id="input-sku" class="form-control" autocomplete="off" />
            </div>
            <div class="form-group">
              <label class="control-label" for="input-quantity">{{ entry_quantity }}</label>
              <input type="text" name="filter_quantity" value="{{ filter_quantity }}" placeholder="{{ entry_quantity }}" id="input-quantity" class="form-control" autocomplete="off" />
            </div>
            <div class="text-right">
              <button type="button" id="button-filter" class="btn btn-primary"><i class="fa fa-filter"></i> {{ button_filter }}</button>
              <button type="button" id="button-reset" class="btn btn-default"><i class="fa fa-refresh"></i> {{ button_reset }}</button>
            </div>
          </div>
        </div>
      </div>
      
      <div class="col-md-9 col-md-pull-3 col-sm-12">
        <div class="panel panel-default">
          <div class="panel-heading">
            <h3 class="panel-title"><i class="fa fa-list"></i> All Product List</h3>
          </div>
          <div class="panel-body">
            <div class="table-responsive">
              <table class="table table-bordered table-hover">
                <thead>
                  <tr>
                    <td class="text-center" width="1%">
                      <a href="{{ sort_sl }}" class="{{ sort == 'p.product_id' ? order|lower : '' }}">SL</a>
                    </td>
                     <td class="text-left">
                      <a href="{{ sort_category }}" class="{{ sort == 'category' ? order|lower : '' }}">Category</a>
                    </td>
                    <td class="text-left">
                      <a href="{{ sort_name }}" class="{{ sort == 'pd.name' ? order|lower : '' }}">{{ column_name }}</a>
                    </td>
                   
                    <td class="text-left">
                      <a href="{{ sort_sku }}" class="{{ sort == 'p.sku' ? order|lower : '' }}">SKU Code</a>
                    </td>
                    <td class="text-right">
                      <a href="{{ sort_weight }}" class="{{ sort == 'p.weight' ? order|lower : '' }}">Self Weight</a>
                    </td>
                    <td class="text-right">
                      <a href="{{ sort_unit_weight }}" class="{{ sort == 'p.unit_weight' ? order|lower : '' }}">Unit Weight</a>
                    </td>
                    <td class="text-right">
                      <a href="{{ sort_purchase_price }}" class="{{ sort == 'purchase_price' ? order|lower : '' }}">Purchase Price</a>
                    </td>
                    {#<td class="text-right">#}
                    {#  <a href="{{ sort_additional_cost }}" class="{{ sort == 'additional_cost' ? order|lower : '' }}">Additional cost</a>#}
                    {#</td>#}
                    <td class="text-right">
                      <a href="{{ sort_price }}" class="{{ sort == 'p.price' ? order|lower : '' }}">Sale Price</a>
                    </td>
                    <td class="text-right">
                      <a href="{{ sort_quantity }}" class="{{ sort == 'p.quantity' ? order|lower : '' }}">{{ column_quantity }}</a>
                    </td>
                    <td class="text-center">{{ column_image }}</td>
                    <td class="text-left">
                      <a href="{{ sort_status }}" class="{{ sort == 'p.status' ? order|lower : '' }}">{{ column_status }}</a>
                    </td>
                  </tr>
                </thead>
                <tbody>
                  {% if products %}
                    {% if order == 'ASC' %}
                        {% set sl = (pagination_page - 1) * pagination_limit + 1 %}
                    {% else %}
                        {% set sl = product_total - ((pagination_page - 1) * pagination_limit) %}
                    {% endif %}
                    
                    {% for product in products %}
                    <tr>
                      <td class="text-center">{{ sl }}</td>
                      {% if order == 'ASC' %}
                          {% set sl = sl + 1 %}
                      {% else %}
                          {% set sl = sl - 1 %}
                      {% endif %}
                      <td class="text-left">{{ product.category }}</td>
                      
                      <td class="text-left">{{ product.name }}</td>
                      
                      <td class="text-left">{{ product.sku ? product.sku : '-' }}</td>
                      <td class="text-right">{{ product.weight }}</td>
                      <td class="text-right">{{ product.unit_weight }} {{ product.weight_class }}</td>
                      <td class="text-right">{{ product.purchase_price }}</td>
                      {#<td class="text-right">{{ product.additional_cost }}</td>#}
                      <td class="text-right">{{ product.price }}</td>
                      <td class="text-right">
                        {% if product.quantity <= 0 %} 
                          <span class="label label-danger">{{ product.quantity }}</span> 
                        {% elseif product.quantity <= 5 %} 
                          <span class="label label-warning">{{ product.quantity }}</span> 
                        {% else %} 
                          <span class="label label-success">{{ product.quantity }}</span> 
                        {% endif %}
                      </td>
                      <td class="text-center">
                        {% if product.image %}
                          <img src="{{ product.image }}" alt="{{ product.name }}" class="img-thumbnail" width="40" height="40" />
                        {% else %}
                          <span class="text-muted">{{ text_no_image }}</span>
                        {% endif %}
                      </td>
                      <td class="text-left">{{ product.status ? "Active" : "InActive" }}</td>
                    </tr>
                    {% endfor %}
                  {% else %}
                    <tr>
                      <td class="text-center" colspan="9">{{ text_no_results }}</td>
                    </tr>
                  {% endif %}
                </tbody>
              </table>
            </div>
            <div class="row">
              <div class="col-sm-6 text-left">{{ pagination }}</div>
              <div class="col-sm-6 text-right">{{ results }}</div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
<script type="text/javascript"><!--
$('#button-filter').on('click', function() {
    var url = 'index.php?route=extension/module/inventory_module/all_products&user_token={{ user_token }}';
    
    var filter_name = $('input[name=\'filter_name\']').val();
    if (filter_name) {
        url += '&filter_name=' + encodeURIComponent(filter_name);
    }
    
    var filter_sku = $('input[name=\'filter_sku\']').val();
    if (filter_sku) {
        url += '&filter_sku=' + encodeURIComponent(filter_sku);
    }
    
    var filter_quantity = $('input[name=\'filter_quantity\']').val();
    if (filter_quantity) {
        url += '&filter_quantity=' + encodeURIComponent(filter_quantity);
    }
    
    location = url;
});

$('#button-reset').on('click', function() {
    var url = 'index.php?route=extension/module/inventory_module/all_products&user_token={{ user_token }}';
    location = url;
});

$('#filter-product input').keydown(function(e) {
    if (e.keyCode == 13) {
        $('#button-filter').trigger('click');
    }
});

// Tooltip initialization
$(document).ready(function() {
    $('[data-toggle="tooltip"]').tooltip();
    $('#input-name').focus();
});
//--></script>

<script type="text/javascript">
$('#button-export-all').on('click', async function() {
    const workbook = new ExcelJS.Workbook();
    const worksheet = workbook.addWorksheet('Inventory');

    worksheet.columns = [
        { header: 'SL', key: 'sl', width: 8 },
        { header: 'Product Name', key: 'name', width: 50 },
        { header: 'Category', key: 'category', width: 30 },
        { header: 'SKU', key: 'sku', width: 15 },
        { header: 'Self Weight', key: 'weight', width: 12 },
        { header: 'Unit Weight', key: 'unit_weight', width: 12 },
        { header: 'Purchase Price', key: 'purchase_price', width: 15 },
        { header: 'Additional Cost', key: 'additional_cost', width: 15 },
        { header: 'Price', key: 'price', width: 15 },
        { header: 'Quantity', key: 'qty', width: 12 },
        { header: 'Status', key: 'status', width: 15 }
    ];

    $('.table-responsive table tbody tr').each(function() {
        const cells = $(this).find('td');
        if (cells.length > 1) {
            const qty = parseInt($(cells[9]).text().trim());
            worksheet.addRow({
                sl: $(cells[0]).text().trim(),
                name: $(cells[1]).text().trim(),         
                category: $(cells[2]).text().trim(),     
                sku: $(cells[3]).text().trim(),          
                weight: $(cells[4]).text().trim(),
                unit_weight: $(cells[5]).text().trim(),  
                purchase_price: $(cells[6]).text().trim(),
                additional_cost: $(cells[7]).text().trim(),
                price: $(cells[8]).text().trim(),
                qty: qty,
                status: $(cells[10]).text().trim()
            });
        }
    });

    // Styling
    const headerRow = worksheet.getRow(1);
    headerRow.font = { bold: true, color: { argb: 'FFFFFF' } };
    headerRow.fill = { type: 'pattern', pattern: 'solid', fgColor: { argb: '2c3e50' } };

    try {
        const buffer = await workbook.xlsx.writeBuffer();
        saveAs(new Blob([buffer]), 'Inventory_List.xlsx');
    } catch (err) {
        console.error(err);
    }
});
</script>

<style type="text/css">
.table-responsive .label {
    padding: 5px 10px;
    font-size: 12px;
}
.img-thumbnail {
    max-width: 40px;
    max-height: 40px;
}
</style>



{{ footer }}