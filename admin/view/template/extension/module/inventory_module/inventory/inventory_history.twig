{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="pull-right">
        <button type="button" id="button-export" data-toggle="tooltip" title="{{ text_export }}" class="btn btn-success"><i class="fa fa-file-excel-o"></i> {{ text_export }}</button>
      </div>
      <h1>{{ heading_title_history }}</h1>
      <ul class="breadcrumb">
        {% for breadcrumb in breadcrumbs %}
        <li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
        {% endfor %}
      </ul>
    </div>
  </div>
  
  <div class="container-fluid">
    <div class="row">
      <div id="filter-history" class="col-md-3 col-md-push-9 col-sm-12">
        <div class="panel panel-default">
          <div class="panel-heading">
            <h3 class="panel-title"><i class="fa fa-filter"></i> {{ text_filter }}</h3>
          </div>
          <div class="panel-body">
            <div class="form-group">
              <label class="control-label">{{ entry_product_name }}</label>
              <input type="text" name="filter_name" value="{{ filter_name }}" placeholder="{{ entry_product_name }}" class="form-control" />
            </div>
            
            <div class="form-group">
              <label class="control-label">{{ entry_sku }}</label>
              <input type="text" name="filter_sku" value="{{ filter_sku }}" placeholder="{{ entry_sku }}" class="form-control" />
            </div>

            <div class="form-group">
              <label class="control-label">{{ entry_lot_number }}</label>
              <input type="text" name="filter_lot" value="{{ filter_lot }}" placeholder="{{ entry_lot_number }}" class="form-control" />
            </div>

            <div class="form-group">
              <label class="control-label">{{ entry_date_range }}</label>
              <select name="filter_date_range" id="select-date-range" class="form-control">
                <option value="lifetime" {% if filter_date_range == 'lifetime' %}selected{% endif %}>{{ text_lifetime }}</option>
                <option value="today" {% if filter_date_range == 'today' %}selected{% endif %}>{{ text_today }}</option>
                <option value="last_7_days" {% if filter_date_range == 'last_7_days' %}selected{% endif %}>{{ text_last_7_days }}</option>
                <option value="last_month" {% if filter_date_range == 'last_month' %}selected{% endif %}>{{ text_last_month }}</option>
                <option value="last_3_months" {% if filter_date_range == 'last_3_months' %}selected{% endif %}>{{ text_last_3_months }}</option>
                <option value="last_year" {% if filter_date_range == 'last_year' %}selected{% endif %}>{{ text_last_year }}</option>
                <option value="custom" {% if filter_date_range == 'custom' %}selected{% endif %}>{{ text_custom }}</option>
              </select>
            </div>

            <div id="custom-date-fields" style="display: {% if filter_date_range == 'custom' %}block{% else %}none{% endif %};">
              <div class="form-group">
                <label class="control-label">{{ entry_date_start }}</label>
                <div class="input-group date">
                  <input type="text" name="filter_date_start" value="{{ filter_date_start }}" placeholder="YYYY-MM-DD" data-date-format="YYYY-MM-DD" class="form-control" />
                  <span class="input-group-btn"><button type="button" class="btn btn-default"><i class="fa fa-calendar"></i></button></span>
                </div>
              </div>
              <div class="form-group">
                <label class="control-label">{{ entry_date_end }}</label>
                <div class="input-group date">
                  <input type="text" name="filter_date_end" value="{{ filter_date_end }}" placeholder="YYYY-MM-DD" data-date-format="YYYY-MM-DD" class="form-control" />
                  <span class="input-group-btn"><button type="button" class="btn btn-default"><i class="fa fa-calendar"></i></button></span>
                </div>
              </div>
            </div>
            
            <div class="form-group text-right">
              <button type="button" id="button-filter" class="btn btn-primary"><i class="fa fa-filter"></i> {{ text_filter }}</button>
              <a href="index.php?route=extension/module/inventory_module/history&user_token={{ user_token }}" class="btn btn-default"><i class="fa fa-refresh"></i> {{ text_clear }}</a>
            </div>
          </div>
        </div>
      </div>

      <div class="col-md-9 col-md-pull-3 col-sm-12">
        <div class="panel panel-default">
          <div class="panel-heading">
            <h3 class="panel-title"><i class="fa fa-list"></i> {{ text_history_list }}</h3>
          </div>
          <div class="panel-body">
            <div class="table-responsive">
              <table class="table table-bordered table-hover">
                <thead>
                  <thead>
                      <tr style="background: #fbfbfb;">
                        <td class="text-left">
                            <a href="{{ sort_date }}" class="{% if sort == 'i.inventory_date' %}{{ order|lower }}{% endif %}">{{ column_date }}</a>
                        </td>
                        <td class="text-left">
                            <a href="{{ sort_lot }}" class="{% if sort == 'i.inventory_lotnumber' %}{{ order|lower }}{% endif %}">{{ column_lot_no }}</a>
                        </td>
                        <td class="text-left">
                            <a href="{{ sort_name }}" class="{% if sort == 'product_name' %}{{ order|lower }}{% endif %}">{{ column_product }}</a>
                        </td>
                        <td class="text-left">
                            <a href="{{ sort_sku }}" class="{% if sort == 'sku' %}{{ order|lower }}{% endif %}">{{ column_sku }}</a>
                        </td>
                        <td class="text-right">
                            <a href="{{ sort_qty }}" class="{% if sort == 'id.quantity' %}{{ order|lower }}{% endif %}">{{ column_qty }}</a>
                        </td>
                        <td class="text-right">
                            <a href="{{ sort_current_quantity }}" class="{% if sort == 'id.current_quantity' %}{{ order|lower }}{% endif %}">Current Qty</a>
                        </td>
                        <td class="text-right">
                            <a href="{{ sort_purchase_price }}" class="{% if sort == 'id.purchase_price' %}{{ order|lower }}{% endif %}">{{ column_purchase_price }}</a>
                        </td>
                        <td class="text-right">
                            <a href="{{ sort_additional_cost }}" class="{% if sort == 'id.additional_cost' %}{{ order|lower }}{% endif %}">{{ column_additional }}</a>
                        </td>
                        <td class="text-right">
                            <a href="{{ sort_total }}" class="{% if sort == 'id.total_price' %}{{ order|lower }}{% endif %}">{{ column_total }}</a>
                        </td>
                        <td class="text-right">
                            <a href="{{ sort_sale_price }}" class="{% if sort == 'id.sale_price' %}{{ order|lower }}{% endif %}">{{ column_sale_price }}</a>
                        </td>
                      </tr>
                    </thead>
                </thead>
                <tbody>
                  {% if histories %}
                    {% for history in histories %}
                    <tr>
                      <td class="text-left">{{ history.date }}</td>
                      <td class="text-left"><span class="label label-info">{{ history.lot_number }}</span></td>
                      <td class="text-left"><strong>{{ history.product_name }}</strong></td>
                      <td class="text-left">{{ history.sku }}</td>
                      <td class="text-right">{{ history.quantity }}</td>
                      <td class="text-right">{{ history.current_quantity }}</td>
                      <td class="text-right">{{ history.purchase_price }}</td>
                      <td class="text-right">{{ history.additional_cost }}</td>
                      <td class="text-right">{{ history.total }}</td>
                      <td class="text-right">{{ history.sale_price }}</td>
                    </tr>
                    {% endfor %}
                  {% else %}
                    <tr><td class="text-center" colspan="10">{{ text_no_results }}</td></tr>
                  {% endif %}
                </tbody>
              </table>
            </div>
            <div class="row">
              <div class="col-sm-6 text-left">{{ pagination }}</div>
              <div class="col-sm-6 text-right">{{ results }}</div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <script src="https://cdnjs.cloudflare.com/ajax/libs/exceljs/4.3.0/exceljs.min.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/FileSaver.js/2.0.5/FileSaver.min.js"></script>
  <script type="text/javascript">
  // 1. Custom Date Fields toggle
  $('#select-date-range').on('change', function() {
    if ($(this).val() == 'custom') {
      $('#custom-date-fields').slideDown();
    } else {
      $('#custom-date-fields').slideUp();
      $('input[name="filter_date_start"], input[name="filter_date_end"]').val('');
    }
  });

  // 2. Filter Button Logic
  $('#button-filter').on('click', function() {
    var url = 'index.php?route=extension/module/inventory_module/history&user_token={{ user_token }}';

    var filter_name = $('input[name="filter_name"]').val();
    if (filter_name) url += '&filter_name=' + encodeURIComponent(filter_name);

    var filter_sku = $('input[name="filter_sku"]').val();
    if (filter_sku) url += '&filter_sku=' + encodeURIComponent(filter_sku);

    var filter_lot = $('input[name="filter_lot"]').val();
    if (filter_lot) url += '&filter_lot=' + encodeURIComponent(filter_lot);

    var filter_date_range = $('#select-date-range').val();
    if (filter_date_range !== 'lifetime') {
      url += '&filter_date_range=' + encodeURIComponent(filter_date_range);
    }

    // Fixed: Capture Start and End dates for Custom Range
    var filter_date_start = $('input[name="filter_date_start"]').val();
    if (filter_date_start) url += '&filter_date_start=' + encodeURIComponent(filter_date_start);

    var filter_date_end = $('input[name="filter_date_end"]').val();
    if (filter_date_end) url += '&filter_date_end=' + encodeURIComponent(filter_date_end);

    location = url;
  });

  // 3. Excel Export Logic
  $('#button-export').on('click', function() {
    const workbook = new ExcelJS.Workbook();
    const worksheet = workbook.addWorksheet('Inventory History');

    // Define Columns
    worksheet.columns = [
        { header: 'Date', key: 'date', width: 15 },
        { header: 'Lot No', key: 'lot', width: 15 },
        { header: 'Product Name', key: 'product', width: 35 },
        { header: 'SKU', key: 'sku', width: 15 },
        { header: 'Qty', key: 'qty', width: 10 },
        { header: 'Current Qty', key: 'c_qty', width: 10 },
        { header: 'Purchase Price', key: 'p_price', width: 15 },
        { header: 'Additional Cost', key: 'add_cost', width: 15 },
        { header: 'Total', key: 'total', width: 15 },
        { header: 'Sale Price', key: 's_price', width: 15 }
    ];

    // Add Rows from Table
    $('.table tbody tr').each(function() {
        const cells = $(this).find('td');
        if (cells.length > 1) { // Skip "No Results"
            worksheet.addRow({
                date: $(cells[0]).text().trim(),
                lot: $(cells[1]).text().trim(),
                product: $(cells[2]).text().trim(),
                sku: $(cells[3]).text().trim(),
                qty: parseFloat($(cells[4]).text().replace(/[^\d.-]/g, '')) || 0,
                c_qty: parseFloat($(cells[5]).text().replace(/[^\d.-]/g, '')) || 0,
                p_price: parseFloat($(cells[6]).text().replace(/[^\d.-]/g, '')) || 0,
                add_cost: parseFloat($(cells[7]).text().replace(/[^\d.-]/g, '')) || 0,
                total: parseFloat($(cells[8]).text().replace(/[^\d.-]/g, '')) || 0,
                s_price: parseFloat($(cells[9]).text().replace(/[^\d.-]/g, '')) || 0
            });
        }
    });

    // Style the Header
    worksheet.getRow(1).font = { bold: true };
    worksheet.getRow(1).fill = {
      type: 'pattern',
      pattern: 'solid',
      fgColor: { argb: 'FBFBFB' }
    };

    // Export File
    workbook.xlsx.writeBuffer().then(function(buffer) {
      saveAs(new Blob([buffer]), 'Inventory_History_' + new Date().toISOString().split('T')[0] + '.xlsx');
    });
  });

  // 4. Date Picker initialization
  $('.date').datetimepicker({
    language: '{{ datepicker }}',
    pickTime: false,
    format: 'YYYY-MM-DD' // Explicitly set format for consistency
  });
</script>
</div>
{{ footer }}