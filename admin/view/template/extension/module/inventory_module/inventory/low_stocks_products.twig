{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="pull-right">
        <button type="button" id="button-export" data-toggle="tooltip" title="Export to Excel" class="btn btn-success"><i class="fa fa-file-excel-o"></i> Export</button>
      </div>
      <h1>{{ heading_title }}</h1>
      <ul class="breadcrumb">
        {% for breadcrumb in breadcrumbs %}
        <li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
        {% endfor %}
      </ul>
    </div>
  </div>
  <div class="container-fluid">
    <div class="panel panel-default">
      <div class="panel-heading">
        <h3 class="panel-title"><i class="fa fa-exclamation-triangle"></i> {{ heading_title }}</h3>
      </div>
      <div class="panel-body">
        <div class="table-responsive">
          <table class="table table-bordered table-hover">
            <thead>
              <tr>
                <td class="text-center"><a href="{{ sort_sl }}" class="{% if sort == 'p.product_id' %}{{ order|lower }}{% endif %}">SL </a></td>
                <td class="text-left"><a href="{{ sort_category }}" class="{{ sort == 'category' ? order|lower : '' }}">Category</a></td>
                <td class="text-left"><a href="{{ sort_name }}" class="{% if sort == 'pd.name' %}{{ order|lower }}{% endif %}">{{ column_name }}</a></td>
                <td class="text-left"><a href="{{ sort_sku }}" class="{% if sort == 'p.sku' %}{{ order|lower }}{% endif %}">SKU Code</a></td>
                  <td class="text-right">
                      <a href="{{ sort_weight }}" class="{{ sort == 'p.weight' ? order|lower : '' }}">Self Weight</a>
                    </td>
                  <td class="text-right">
                      <a href="{{ sort_unit_weight }}" class="{{ sort == 'p.unit_weight' ? order|lower : '' }}">Unit Weight</a>
                    </td>
                    <td class="text-right">
                      <a href="{{ sort_purchase_price }}" class="{{ sort == 'purchase_price' ? order|lower : '' }}">Purchase Price</a>
                    </td>
                   
                   
                <td class="text-right"><a href="{{ sort_price }}" class="{% if sort == 'p.price' %}{{ order|lower }}{% endif %}">Sale Price</a></td>
                <td class="text-right"><a href="{{ sort_quantity }}" class="{% if sort == 'p.quantity' %}{{ order|lower }}{% endif %}">Quantity</a></td>
                <td class="text-center">{{ column_image }}</td>
                <td class="text-right"><a href="{{ sort_status }}" class="{% if sort == 'p.status' %}{{ order|lower }}{% endif %}">Status</a></td>
                <td class="text-right">Action</td>
              </tr>
            </thead>
            <tbody>
              {% if products %}
                {% for product in products %}
                  {# SL Reverse Sorting Logic #}
                  {% if order == 'ASC' %}
                    {% set sl_no = ((pagination_page - 1) * pagination_limit) + loop.index %}
                  {% else %}
                    {% set sl_no = product_total - ((pagination_page - 1) * pagination_limit) - loop.index0 %}
                  {% endif %}
                  
                  <tr>
                    <td class="text-center">{{ sl_no }}</td>
                    <td class="text-left">{{ product.category }}</td>
                    <td class="text-left">{{ product.name }}</td>
                    <td class="text-left">{{ product.sku }}</td>
                    <td class="text-right">{{ product.weight }}</td>
                    <td class="text-right">{{ product.unit_weight }} {{ product.weight_class }}</td>
                    <td class="text-right">{{ product.purchase_price }}</td>
                    <td class="text-right">{{ product.price }}</td>
                    <td class="text-right">
                      {% if product.quantity <= 0 %}
                        <span class="label label-danger">{{ product.quantity }}</span>
                      {% else %}
                        <span class="label label-warning">{{ product.quantity }}</span>
                      {% endif %}
                    </td>
                    <td class="text-center">
                      <img src="{{ product.image }}" alt="{{ product.name }}" class="img-thumbnail" style="max-width: 40px;" />
                    </td>
                    <td class="text-left">{{ product.status ? "Active" : "InActive" }}</td>
                    <td class="text-right">
                      <a href="{{ product.edit }}" data-toggle="tooltip" title="Edit" class="btn btn-primary"><i class="fa fa-pencil"></i></a>
                    </td>
                  </tr>
                {% endfor %}
              {% else %}
                <tr>
                  <td class="text-center" colspan="11">{{ text_no_results }}</td>
                </tr>
              {% endif %}
            </tbody>
          </table>
        </div>
        <div class="row">
          <div class="col-sm-6 text-left">{{ pagination }}</div>
          <div class="col-sm-6 text-right">{{ results }}</div>
        </div>
      </div>
    </div>
  </div>
</div>

<script type="text/javascript">
$('#button-export').on('click', async function() {
    const workbook = new ExcelJS.Workbook();
    const worksheet = workbook.addWorksheet('Low Stock Report');

    worksheet.columns = [
        { header: 'SL', key: 'sl', width: 10 },
        { header: 'Product Name', key: 'name', width: 35 },
        { header: 'Category', key: 'category', width: 20 },
        { header: 'SKU', key: 'sku', width: 20 },
        { header: 'Self Weight', key: 'weight', width: 15 },
        { header: 'Unit Weight', key: 'unit_weight', width: 15 },
        { header: 'Purchase Price', key: 'p_price', width: 15 },
        { header: 'Sale Price', key: 's_price', width: 15 },
        { header: 'Stock Qty', key: 'qty', width: 15 }
    ];

    $('.table tbody tr').each(function() {
        const cells = $(this).find('td');
        
        if (cells.length > 1) {
            const statusText = $(cells[9]).text().trim();
            const qtyMatch = statusText.match(/\(([^)]+)\)/);
            const qty = qtyMatch ? qtyMatch[1] : '0';

            worksheet.addRow({
                sl: $(cells[0]).text().trim(),
                name: $(cells[2]).text().trim(),
                category: $(cells[3]).text().trim(),
                sku: $(cells[4]).text().trim(),
                weight: $(cells[5]).text().trim(),
                unit_weight: $(cells[5]).text().trim(),
                p_price: $(cells[6]).text().trim(),
                s_price: $(cells[8]).text().trim(),
                qty: parseInt(qty)
            });
        }
    });

    // Formatting Header
    const headerRow = worksheet.getRow(1);
    headerRow.font = { bold: true, color: { argb: 'FFFFFF' } };
    headerRow.fill = { type: 'pattern', pattern: 'solid', fgColor: { argb: 'D9534F' } };

    worksheet.eachRow((row) => {
        row.eachCell((cell) => {
            cell.border = { top: {style:'thin'}, left: {style:'thin'}, bottom: {style:'thin'}, right: {style:'thin'} };
        });
    });

    const buffer = await workbook.xlsx.writeBuffer();
    saveAs(new Blob([buffer]), 'Low_Stock_Report_' + new Date().toISOString().slice(0,10) + '.xlsx');
});
</script>
{{ footer }}