{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="pull-right">
          <a href="{{ add }}" data-toggle="tooltip" title="{{ text_add }}" class="btn btn-primary"><i class="fa fa-plus"></i></a>
          <button type="button" id="button-export-employees" data-toggle="tooltip" title="Export to Excel" class="btn btn-success"><i class="fa fa-file-excel-o"></i> Export</button>
          <button type="button" data-toggle="tooltip" title="{{ button_delete }}" class="btn btn-danger" onclick="confirm('{{ text_confirm }}') ? $('#form-employee').submit() : false;"><i class="fa fa-trash-o"></i></button>
        </div>
      <h1>{{ heading_title }}</h1>
      <ul class="breadcrumb">
        {% for breadcrumb in breadcrumbs %}
        <li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
        {% endfor %}
      </ul>
    </div>
  </div>

  <div class="container-fluid">
    {{ messages }}
    
    <div class="panel panel-default">
      <div class="panel-heading">
        <h3 class="panel-title"><i class="fa fa-list"></i> {{ text_employee_list }}</h3>
      </div>
      <div class="panel-body">
        <form action="{{ delete }}" method="post" enctype="multipart/form-data" id="form-employee">
          <div class="table-responsive">
            <table class="table table-bordered table-hover">
              <thead>
                  <tr>
                    <td style="width: 1px;" class="text-center">
                      <input type="checkbox" onclick="$('input[name*=\'selected\']').prop('checked', this.checked);" />
                    </td>
                    <td class="text-center">Image</td>
                
                    <td class="text-left">
                      <a href="{{ sort_name }}" class="{% if sort == 'name' %}{{ order|lower }}{% endif %}">Employee Name</a>
                    </td>
                    
                    <td class="text-left">
                      <a href="{{ sort_designation }}" class="{% if sort == 'designation' %}{{ order|lower }}{% endif %}">Designation</a>
                    </td>
                    
                    <td class="text-left">
                      <a href="{{ sort_email }}" class="{% if sort == 'email' %}{{ order|lower }}{% endif %}">Email</a>
                    </td>
                    
                    <td class="text-left">
                      <a href="{{ sort_mobile }}" class="{% if sort == 'mobile' %}{{ order|lower }}{% endif %}">Mobile Number</a>
                    </td>
                    
                    <td class="text-right">
                      <a href="{{ sort_salary }}" class="{% if sort == 'salary' %}{{ order|lower }}{% endif %}">Salary</a>
                    </td>
                    
                    <td class="text-center">
                      <a href="{{ sort_status }}" class="{% if sort == 'status' %}{{ order|lower }}{% endif %}">Status</a>
                    </td>
                    
                    <td class="text-right">Action</td>
                  </tr>
                </thead>
              <tbody>
                {% if employees %}
                {% for emp in employees %}
                <tr>
                  <td class="text-center">
                    <input type="checkbox" name="selected[]" value="{{ emp.emp_id }}" />
                  </td>
                  <td class="text-center">
                    {% if emp.image %}
                    <img src="{{ emp.image }}" alt="{{ emp.name }}" class="img-thumbnail" style="width: 40px; height: 40px;" />
                    {% else %}
                    <i class="fa fa-user fa-2x"></i>
                    {% endif %}
                  </td>
                  <td class="text-left"><strong>{{ emp.name }}</strong></td>
                  <td class="text-left"><span class="text-muted">{{ emp.designation }}</span></td>
                  <td class="text-left">{{ emp.email }}</td>
                  <td class="text-left">{{ emp.phone }}</td> {# Note: Using phone as per your DB #}
                  <td class="text-right">{{ emp.salary }}</td>
                  <td class="text-center">
                    {% if emp.status == 1 %}
                    <span class="label label-success">{{ text_enabled }}</span>
                    {% else %}
                    <span class="label label-danger">{{ text_disabled }}</span>
                    {% endif %}
                  </td>
                  <td class="text-right">
                    <a href="{{ emp.edit }}" data-toggle="tooltip" title="{{ text_edit }}" class="btn btn-primary"><i class="fa fa-pencil"></i></a>
                  </td>
                </tr>
                {% endfor %}
                {% else %}
                <tr>
                  <td class="text-center" colspan="9">{{ text_no_results }}</td>
                </tr>
                {% endif %}
              </tbody>
            </table>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>

<script type="text/javascript">
$('#button-export-employees').on('click', async function() {
    const workbook = new ExcelJS.Workbook();
    const worksheet = workbook.addWorksheet('Employee List');

    // 1. Define Columns (Excluding checkboxes and images)
    worksheet.columns = [
        { header: 'Employee Name', key: 'name', width: 30 },
        { header: 'Designation', key: 'designation', width: 25 },
        { header: 'Email Address', key: 'email', width: 30 },
        { header: 'Mobile Number', key: 'phone', width: 20 },
        { header: 'Salary', key: 'salary', width: 15 },
        { header: 'Status', key: 'status', width: 15 }
    ];

    // 2. Loop through table rows
    $('#form-employee table tbody tr').each(function() {
        const cells = $(this).find('td');
        
        // Skip the "No Results" row
        if (cells.length > 1) {
            worksheet.addRow({
                name: $(cells[2]).text().trim(),        // Name is in 3rd <td>
                designation: $(cells[3]).text().trim(), // Designation in 4th <td>
                email: $(cells[4]).text().trim(),       // Email in 5th <td>
                phone: $(cells[5]).text().trim(),       // Phone in 6th <td>
                salary: $(cells[6]).text().trim(),      // Salary in 7th <td>
                status: $(cells[7]).find('.label').text().trim() // Status text from Label
            });
        }
    });

    // 3. Professional Styling
    const headerRow = worksheet.getRow(1);
    headerRow.font = { bold: true, color: { argb: 'FFFFFF' } };
    headerRow.fill = {
        type: 'pattern',
        pattern: 'solid',
        fgColor: { argb: '337ab7' } // Matches primary UI blue
    };
    headerRow.alignment = { horizontal: 'center' };

    // Apply Borders
    worksheet.eachRow((row) => {
        row.eachCell((cell) => {
            cell.border = {
                top: {style:'thin'}, left: {style:'thin'}, bottom: {style:'thin'}, right: {style:'thin'}
            };
        });
    });

    // 4. Download the File
    try {
        const buffer = await workbook.xlsx.writeBuffer();
        const dateStr = new Date().toISOString().slice(0, 10);
        saveAs(new Blob([buffer]), 'Employee_List_' + dateStr + '.xlsx');
    } catch (e) {
        console.error('Export Error:', e);
        alert('Failed to export employee data.');
    }
});
</script>
{{ footer }}