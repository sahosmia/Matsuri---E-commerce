{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="pull-right">
        <button type="submit" form="form-shipping-pathao" data-toggle="tooltip" title="{{ button_save }}" class="btn btn-primary"><i class="fa fa-save"></i></button>
        <a href="{{ cancel }}" data-toggle="tooltip" title="{{ button_cancel }}" class="btn btn-default"><i class="fa fa-reply"></i></a>
      </div>
      <h1>{{ heading_title }}</h1>
      <ul class="breadcrumb">
        {% for breadcrumb in breadcrumbs %}
        <li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
        {% endfor %}
      </ul>
    </div>
  </div>
  <div class="container-fluid">
    {% if error_warning %}
    <div class="alert alert-danger alert-dismissible"><i class="fa fa-exclamation-circle"></i> {{ error_warning }}
      <button type="button" class="close" data-dismiss="alert">&times;</button>
    </div>
    {% endif %}
    <div class="panel panel-default">
      <div class="panel-heading">
        <h3 class="panel-title"><i class="fa fa-pencil"></i> {{ text_edit }}</h3>
      </div>
      <div class="panel-body">
        <form action="{{ action }}" method="post" enctype="multipart/form-data" id="form-shipping-pathao" class="form-horizontal">
          <div class="form-group">
            <label class="col-sm-2 control-label" for="input-merchant-username">{{ entry_merchant_username }}</label>
            <div class="col-sm-10">
              <input type="text" name="shipping_pathao_merchant_username" value="{{ shipping_pathao_merchant_username }}" placeholder="{{ entry_merchant_username }}" id="input-merchant-username" class="form-control" />
              <small class="text-muted">{{ help_merchant_username }}</small>
            </div>
          </div>
          <div class="form-group">
            <label class="col-sm-2 control-label" for="input-merchant-password">{{ entry_merchant_password }}</label>
            <div class="col-sm-10">
              <input type="password" name="shipping_pathao_merchant_password" value="{{ shipping_pathao_merchant_password }}" placeholder="{{ entry_merchant_password }}" id="input-merchant-password" class="form-control" autocomplete="off" />
              <small class="text-muted">{{ help_merchant_password }}</small>
            </div>
          </div>
          <div class="form-group">
            <label class="col-sm-2 control-label" for="input-client-id">{{ entry_client_id }}</label>
            <div class="col-sm-10">
              <input type="text" name="shipping_pathao_client_id" value="{{ shipping_pathao_client_id }}" placeholder="{{ entry_client_id }}" id="input-client-id" class="form-control" />
              <small class="text-muted">{{ help_client_id }}</small>
            </div>
          </div>
          <div class="form-group">
            <label class="col-sm-2 control-label" for="input-client-secret">{{ entry_client_secret }}</label>
            <div class="col-sm-10">
              <input type="password" name="shipping_pathao_client_secret" value="{{ shipping_pathao_client_secret }}" placeholder="{{ entry_client_secret }}" id="input-client-secret" class="form-control" autocomplete="off" />
              <small class="text-muted">{{ help_client_secret }}</small>
            </div>
          </div>
          <div class="form-group">
            <label class="col-sm-2 control-label" for="input-environment">{{ entry_environment }}</label>
            <div class="col-sm-10">
              <select name="shipping_pathao_sandbox" id="input-environment" class="form-control">
                <option value="1" {% if shipping_pathao_sandbox %}selected="selected"{% endif %}>{{ text_environment_sandbox }}</option>
                <option value="0" {% if not shipping_pathao_sandbox %}selected="selected"{% endif %}>{{ text_environment_live }}</option>
              </select>
              <small class="text-muted">{{ help_environment }}</small>
            </div>
          </div>
          <div class="form-group">
            <label class="col-sm-2 control-label" for="input-webhook-url">{{ entry_webhook_url }}</label>
            <div class="col-sm-10">
              <input type="text" id="input-webhook-url" class="form-control" value="{{ shipping_pathao_webhook_url }}" readonly />
              <small class="text-muted">{{ help_webhook_url }}</small>
            </div>
          </div>
          <div class="form-group">
            <label class="col-sm-2 control-label" for="input-webhook-secret">{{ entry_webhook_secret }}</label>
            <div class="col-sm-10">
              <input type="text" id="input-webhook-secret" class="form-control" value="{{ shipping_pathao_webhook_secret }}" placeholder="{{ text_save_to_generate }}" readonly />
              <small class="text-muted">{{ help_webhook_secret }}</small>
            </div>
          </div>
          <div class="form-group">
            <label class="col-sm-2 control-label">{{ entry_stores_saved }}</label>
            <div class="col-sm-10">
              <div id="pathao-test-alert" class="alert alert-success" style="display:none;"><i class="fa fa-check-circle"></i> <span id="pathao-test-alert-msg"></span></div>
              <button type="button" id="btn-test-pathao" class="btn btn-info"><i class="fa fa-plug"></i> {{ button_test_connection }}</button>
              <span id="pathao-test-status" class="text-muted" style="margin-left:10px;"></span>
              <div id="pathao-stores-list" class="form-control" style="margin-top:8px; min-height:60px; max-height:120px; overflow-y:auto;">
                {% if pathao_stores is not empty %}
                  {% for store in pathao_stores %}
                  <div><strong>{{ store.store_name ?? store.name }}</strong> (ID: {{ store.store_id ?? store.id }}){% if (store.store_id ?? store.id) == pathao_default_store_id %} <span class="label label-success">{{ text_default }}</span>{% endif %}</div>
                  {% endfor %}
                {% else %}
                  <span class="text-muted">{{ text_no_stores_run_test }}</span>
                {% endif %}
              </div>
              <small class="text-muted">{{ help_stores_saved }}</small>
            </div>
          </div>
          <div class="form-group">
            <label class="col-sm-2 control-label" for="input-pickup-address">{{ entry_pickup_address }}</label>
            <div class="col-sm-10">
              <textarea name="shipping_pathao_pickup_address" rows="3" placeholder="{{ entry_pickup_address }}" id="input-pickup-address" class="form-control">{{ shipping_pathao_pickup_address }}</textarea>
              <small class="text-muted">{{ help_pickup_address }}</small>
            </div>
          </div>
          <div class="form-group">
            <label class="col-sm-2 control-label" for="input-status">{{ entry_status }}</label>
            <div class="col-sm-10">
              <select name="shipping_pathao_status" id="input-status" class="form-control">
                {% if shipping_pathao_status %}
                <option value="1" selected="selected">{{ text_enabled }}</option>
                <option value="0">{{ text_disabled }}</option>
                {% else %}
                <option value="1">{{ text_enabled }}</option>
                <option value="0" selected="selected">{{ text_disabled }}</option>
                {% endif %}
              </select>
            </div>
          </div>
          <div class="form-group">
            <label class="col-sm-2 control-label" for="input-sort-order">{{ entry_sort_order }}</label>
            <div class="col-sm-10">
              <input type="number" name="shipping_pathao_sort_order" value="{{ shipping_pathao_sort_order }}" placeholder="{{ entry_sort_order }}" id="input-sort-order" class="form-control" min="0" />
            </div>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>
<script type="text/javascript"><!--
$('#btn-test-pathao').on('click', function() {
  var $btn = $(this);
  var $status = $('#pathao-test-status');
  var $alert = $('#pathao-test-alert');
  var $list = $('#pathao-stores-list');

  $btn.prop('disabled', true);
  $alert.hide();
  $status.removeClass('text-danger text-success').addClass('text-muted').html('<i class="fa fa-spinner fa-spin"></i> {{ text_testing }}');

  $.ajax({
    url: '{{ test_connection_url }}',
    type: 'post',
    data: $('#form-shipping-pathao').serialize(),
    dataType: 'json',
    success: function(json) {
      $btn.prop('disabled', false);
      if (json.success) {
        $status.removeClass('text-muted text-danger').addClass('text-success').html('<i class="fa fa-check"></i> ' + json.message);
        $alert.removeClass('alert-danger').addClass('alert-success').show();
        $('#pathao-test-alert-msg').text(json.message || '{{ text_connection_success }}');

        var html = '';
        if (json.stores && json.stores.length) {
          for (var i = 0; i < json.stores.length; i++) {
            var s = json.stores[i];
            var id = (s.id || s.store_id);
            var name = (s.name || s.store_name || '');
            html += '<div><strong>' + name + '</strong> (ID: ' + id + ')';
            if (id == json.default_store_id) html += ' <span class="label label-success">{{ text_default }}</span>';
            html += '</div>';
          }
        } else {
          html = '<span class="text-muted">{{ text_no_stores_run_test }}</span>';
        }
        $list.html(html);
      } else {
        $alert.removeClass('alert-success').addClass('alert-danger').show();
        $('#pathao-test-alert-msg').text(json.message || '{{ text_connection_failed }}');
        $status.removeClass('text-muted text-success').addClass('text-danger').html('<i class="fa fa-exclamation-circle"></i> ' + (json.message || '{{ text_connection_failed }}'));
      }
    },
    error: function() {
      $btn.prop('disabled', false);
      $alert.removeClass('alert-success').addClass('alert-danger').show();
      $('#pathao-test-alert-msg').text('{{ text_connection_invalid }}');
      $status.removeClass('text-muted text-success').addClass('text-danger').html('');
    }
  });
});
//--></script>
{{ footer }}

